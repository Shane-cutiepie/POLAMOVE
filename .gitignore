# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code. Ignored here so each teammate keeps their own local editor setup.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Legacy pub metadata
.packages

# Build output in any subdirectory (the /build/ rule above is root-only)
build/

# Signing keys. android/.gitignore already covers android/**; these catch a
# keystore left anywhere else in the tree.
*.jks
*.keystore
key.properties
admin/maps-config.js
web/maps-config.js

# macOS
**/.DS_Store

# Note: android/.gradle, android/local.properties and ios/Pods are ignored by
# android/.gitignore and ios/.gitignore respectively.
#
# pubspec.lock is intentionally NOT ignored. PolaMove is an application, not a
# package, so the lockfile is committed to keep all three developers on
# identical dependency versions.
